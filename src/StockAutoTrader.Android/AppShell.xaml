<?xml version="1.0" encoding="UTF-8" ?>
<maui:FlyoutPage
    x:Class="StockAutoTrader.Android.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maui="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:views="clr-namespace:StockAutoTrader.Android.Views">

    <maui:FlyoutPage.FlyoutContent>
        <ListView ItemsSource="{Binding MenuItems}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextCell Text="{Binding Title}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </maui:FlyoutPage.FlyoutContent>

    <maui:FlyoutPage.Content>
        <views:MonitoringPage />
    </maui:FlyoutPage.Content>

</maui:FlyoutPage>
