<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="StockAutoTrader.AndroidApp.Views.MonitoringPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="股票监控"
    BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <VerticalStackLayout Spacing="12" Padding="16">

            <!-- 状态栏 -->
            <HorizontalStackLayout Spacing="8">
                <Label Text="状态：" FontSize="14" VerticalOptions="Center" />
                <Label x:Name="StatusLabel" Text="已停止" FontSize="14"
                       TextColor="{StaticResource Primary}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- 账户信息 -->
            <Frame HasShadow="True" CornerRadius="8" Padding="12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="账户资金" FontSize="12" TextColor="Gray" />
                    <Label x:Name="BalanceLabel" Text="—" FontSize="16" FontAttributes="Bold" />
                    <Label Text="总市值" FontSize="12" TextColor="Gray" Margin="0,8,0,0" />
                    <Label x:Name="MarketValueLabel" Text="—" FontSize="16" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Frame>

            <!-- 持仓列表 -->
            <Label Text="当前持仓" FontSize="16" FontAttributes="Bold" />
            <ListView x:Name="PositionList" HasUnevenRows="True">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Grid Padding="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="{Binding StockCode}" FontSize="14" FontAttributes="Bold" />
                                    <Label Text="{Binding StockName}" FontSize="12" TextColor="Gray" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                                    <Label Text="{Binding AvailableQuantity, StringFormat='可卖：{0} 股'}"
                                           FontSize="12" />
                                    <Label Text="{Binding MarketValue, StringFormat='市值：{0:C}'}"
                                           FontSize="12" TextColor="Gray" />
                                </VerticalStackLayout>
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 控制按钮 -->
            <HorizontalStackLayout Spacing="12" Margin="0,8,0,0">
                <Button x:Name="StartButton" Text="启动监控"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White" CornerRadius="8"
                        Command="{Binding StartCommand}" />
                <Button x:Name="StopButton" Text="停止监控"
                        BackgroundColor="{StaticResource Danger}"
                        TextColor="White" CornerRadius="8"
                        Command="{Binding StopCommand}" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
