<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.stockautotrader.android</ApplicationId>
    <ApplicationVersion>1.0</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <PackageId>com.stockautotrader</PackageId>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <LangVersion>12.0</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <IgnoreEolTargetFramework>true</IgnoreEolTargetFramework>
    <RootNamespace>StockAutoTrader.AndroidApp</RootNamespace>
    <AssemblyName>StockAutoTrader.AndroidApp</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.120" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StockAutoTrader.Core\StockAutoTrader.Core.csproj" />
    <ProjectReference Include="..\StockAutoTrader.Infrastructure\StockAutoTrader.Infrastructure.csproj" />
  </ItemGroup>

</Project>
