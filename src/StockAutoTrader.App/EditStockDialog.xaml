<Window x:Class="StockAutoTrader.App.EditStockDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑股票策略" Height="600" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="股票代码" Margin="0,5"/>
        <TextBox Grid.Row="1" Text="{Binding StockCode, Mode=TwoWay}" Height="28"/>

        <TextBlock Grid.Row="2" Text="股票名称" Margin="0,5"/>
        <TextBox Grid.Row="3" Text="{Binding StockName, Mode=TwoWay}" Height="28"/>

        <TextBlock Grid.Row="4" Text="买入阈值(%)" Margin="0,5"/>
        <TextBox Grid.Row="5" Text="{Binding BuyThresholdPercent, Mode=TwoWay}" Height="28"/>

        <TextBlock Grid.Row="6" Text="卖出阈值(%)" Margin="0,5"/>
        <TextBox Grid.Row="7" Text="{Binding SellThresholdPercent, Mode=TwoWay}" Height="28"/>

        <TextBlock Grid.Row="8" Text="买入数量" Margin="0,5"/>
        <TextBox Grid.Row="9" Text="{Binding BuyQuantity, Mode=TwoWay}" Height="28"/>

        <TextBlock Grid.Row="10" Text="卖出数量" Margin="0,5"/>
        <TextBox Grid.Row="11" Text="{Binding SellQuantity, Mode=TwoWay}" Height="28"/>

        <StackPanel Grid.Row="12" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
            <Button Content="确定" Width="100" Height="32" Margin="5" Click="Ok_Click" Background="#FF2196F3" Foreground="White" BorderThickness="0"/>
            <Button Content="取消" Width="100" Height="32" Margin="5" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
